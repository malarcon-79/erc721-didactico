# Variables de entorno para el proyecto ERC-721 Didáctico
# ⚠️ NUNCA subas el archivo .env a GitHub

# URL del nodo RPC de Sepolia (https://infura.io o https://alchemy.com)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/TU_PROJECT_ID

# Clave privada de tu wallet MetaMask (sin el prefijo 0x)
# ⚠️ NUNCA uses una wallet con fondos reales para pruebas
PRIVATE_KEY=tu_private_key_de_metamask_sin_0x

# Claves de Pinata para subir metadata a IPFS (https://pinata.cloud)
PINATA_API_KEY=tu_api_key_de_pinata
PINATA_SECRET_KEY=tu_secret_key_de_pinata
